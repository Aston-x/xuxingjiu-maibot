+def _split_scope(person_id: str) -> tuple[str, str]:
+    """拆开「人 ID#会话 ID」。
+
+    2026-10-21 本机补丁：卡片主键带会话维度后，库里存的是「raw#scope」，
+    而 ctx.db / ctx.person 只认 raw —— 凡是拿库里 person_id 回查宿主的地方，
+    都要先拆一下。
+    """
+    pid = str(person_id or "").strip()
+    if "#" in pid:
+        base, _, scope = pid.partition("#")
+        return base, scope
+    return pid, ""
