+def _normalize_for_compare(text: object, *, strip_terms: Sequence[str] = ()) -> str:
+    """去掉标点空白后的小写串，用于相似度比较。
+
+    ``strip_terms`` 一般传人物称呼（主称呼 / 人物ID）——
+    每个人的要点都带同一个名字，它会把「同一个人」的两条不同事实
+    强行拉近（「A 喜欢猫」/「A 喜欢狗」的字面相似度很高），
+    比较前先摘掉才靠得住。
+    """
+
+    cleaned = re.sub(r"[^0-9a-zA-Z\u4e00-\u9fff]+", "", str(text or "")).lower()
+    for term in strip_terms:
+        stripped = re.sub(r"[^0-9a-zA-Z\u4e00-\u9fff]+", "", str(term or "")).lower()
+        if len(stripped) >= 2:
+            cleaned = cleaned.replace(stripped, "")
+    return cleaned
+
+
+def _digit_signature(text: object) -> str:
+    """取文本里的阿拉伯数字串。用来挡住「只差一个数字」的不同事实。"""
+
+    return "".join(ch for ch in str(text or "") if ch.isdigit())
