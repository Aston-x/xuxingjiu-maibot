+def bullets_are_similar(left: object, right: object, *, strip_terms: Sequence[str] = ()) -> bool:
+    """判断两条要点是不是在说同一件事。
+
+    用两个互补的判据（任一命中即算近似）：
+
+    1. **字符序列相似度**（difflib，跑在**原文**上）—— 抓只换了语序的改写；
+    2. **字符集 Jaccard**（跑在**去掉称呼**的文本上）—— 抓语序差很多、
+       但用词高度重合的改写。
+       之所以第二个判据要去称呼：每个人的要点都带同一个名字，
+       它会把「同一个人」的两条不同事实强行拉近。
+
+    两个判据都会跳过太短的句子，避免把只差一两个字的不同事实合并掉；
+    **数字不同的一律不算重复**（「有 3 张卡」与「有 5 张卡」字面极像，
+    但它们是两件事）。
+    """
+
+    left_raw = _normalize_for_compare(left)
+    right_raw = _normalize_for_compare(right)
+    if len(left_raw) < NEAR_DUP_MIN_CHARS or len(right_raw) < NEAR_DUP_MIN_CHARS:
+        return False
+    if _digit_signature(left_raw) != _digit_signature(right_raw):
+        return False
+    if difflib.SequenceMatcher(None, left_raw, right_raw).ratio() >= NEAR_DUP_RATIO:
+        return True
+    left_chars = set(_normalize_for_compare(left, strip_terms=strip_terms))
+    right_chars = set(_normalize_for_compare(right, strip_terms=strip_terms))
+    union = left_chars | right_chars
+    if not union:
+        return False
+    return len(left_chars & right_chars) / len(union) >= NEAR_DUP_JACCARD
+
